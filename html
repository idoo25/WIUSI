        //#region 💎 Lab Diamond Type Toggles (Own vs. Final Sale)
        function toggleLabDiamondType(changedBtnId) {
            const $returnLab = $('#btnReturnLabDiamond');
            const $finalSaleLab = $('#btnFinalSaleLabDiamond');
            const $quickShipping = $('#btnQuickShipping');

            // Get current states
            let isReturnLabChecked = $returnLab.prop('checked');
            let isFinalSaleChecked = $finalSaleLab.prop('checked');
            const isQuickShippingChecked = $quickShipping.prop('checked');

            // Enforce mutual exclusivity: only one can be selected at a time
            if (changedBtnId === 'btnReturnLabDiamond' && isReturnLabChecked) {
                $finalSaleLab.prop('checked', false);
                isFinalSaleChecked = false;
            } else if (changedBtnId === 'btnFinalSaleLabDiamond' && isFinalSaleChecked) {
                $returnLab.prop('checked', false);
                isReturnLabChecked = false;
            }

            // Reset visual styles
            $returnLab.parent().css('background-color', '#fff');
            $finalSaleLab.parent().css('background-color', '#fff');

            // Highlight selected
            if (isReturnLabChecked) $returnLab.parent().css('background-color', '#005e62');
            if (isFinalSaleChecked) $finalSaleLab.parent().css('background-color', '#005e62');

            // Update ViewModel logic
            filterVM.IsSourcedLabDiamond = isFinalSaleChecked; // true only for final sale
            filterVM.IsMasterMixLabDiamond = !(isReturnLabChecked || isFinalSaleChecked); // true only when both are unselected
            filterVM.IsQuickShipping = isQuickShippingChecked;

            // Toggle disclaimer (show if returnable not selected)
            $('#divDisclaimer').toggleClass('d-none', !isFinalSaleChecked);

            // Refresh
            p_SwitchOffIsSaleOn();
            pageNo = 1;
            filterShopDiamondTable(pageNo);
