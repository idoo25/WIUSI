        $("#CustomDiamondSettingModalButton").click(function () {
            setupCustomDiamondSettingValidation();

            // Build DiamondSpec string from SettingVM
            const settingFields = ['Shape', 'CrtWt', 'Color', 'Clarity', 'Price', 'Cut'];
            const diamondSpec = settingFields.map(f => SettingVM[f] || '').join(' ');
            $("input[name=DiamondSpec]:hidden").val(diamondSpec);

            if ($("#customDiamondSettingfrmsubmit").valid()) {
                $.ajax({
                    url: "/Shop/SentCustomDiamondSettingMail",
                    type: 'POST',
                    data: $("#customDiamondSettingfrmsubmit").serialize(),
                    success: function (data) {
                        if (data.result === true) {
                            $("#CustomDiamondSettingModal-Message").show();
                            $("#CustomDiamondSettingModal-Enter").hide();
                            clearCustomDiamondSetting();
                        }
                    },
                    error: function (err) {
                        console.error("Error sending custom diamond setting:", err);
                    }
                });
            }
        });

        function setupCustomDiamondSettingValidation() {
            $("#customDiamondSettingfrmsubmit").validate({
                ignore: ":hidden:not(.RecaptchaResponse)", // validate hidden Recaptcha
                rules: {
                    Email: {
                        required: true,
                        email: true
                    },
                    RecaptchaResponse: {
                        required: true
                    }
                },
                messages: {
                    Email: {
                        required: "Email address is required.",
                        email: "Enter a valid email address."
                    },
                    RecaptchaResponse: {
                        required: "Please confirm you are not a robot."
                    }
                }
            });

            // Ensure Recaptcha rule is applied properly
            $("#RecaptchaResponse").rules("add", {
                required: true,
                ignore: false
            });
        }

        //#endregion

        //#region 🧹 Reset and Clear Modal States

        function clearCustomDiamondSetting() {
            $('#customDiamondSettingfrmsubmit')[0].reset();
            $('.customDiamondSetting').removeClass('metalBorder');
            $('#id14MetalWhiteDiamondSetting').addClass('metalBorder');

            const defaultMetal = "14K White Gold";
            $('#metalCustomDiamondSettingDisplay').text(defaultMetal);
            $('#hidMetal').val(defaultMetal);

            grecaptcha.reset();
        }

        function resetModalCustomDiamondSetting() {
            $("#CustomDiamondSettingModal-Message").hide();
            $("#CustomDiamondSettingModal-Enter").show();
        }

        //#endregion

        //#region 🛡️ Recaptcha Integration

        function setRecaptchaResponse(response) {
            $("#RecaptchaResponse").val(response);
            $("#customDiamondSettingfrmsubmit").valid();
        }

