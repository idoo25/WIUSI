        // Common function to handle AJAX call for ShopDiamondTable
        function performShopDiamondAjax(filterVM, beforeSendCallback, successCallback) {
            $.ajax({
                url: "/Shop/_ShopDiamondTable",
                data: filterVM,
                beforeSend: beforeSendCallback,
                traditional: true,
                success: function (result) {
                    // Common success logic
                    p_IsAjaxPaginationCallSuccess = true;
                    if (result.isDataExists) {
                        localStorage.setItem('pageNo', 1);
                        dataOver = true;
                    }
                    if (result.dataOver) {
                        dataOver = true;
                    }
                    if (result.isNewData) {
                        $('#dtInventory tbody').empty();
                        $('#dtInventory tbody').append(result.partialData);
                        dataOver = false;
                    } else {
                        $('#dtInventory tbody').append(result.partialData);
                    }
                    if (result.isNoDataFound == true) {
                        $('#dtInventory tbody').empty();
                        $('.tblShopDiamondDiv').addClass('d-none');
                        $('.setingDiv').removeClass('d-none');
                        $('.setingDiv').empty();
                        $('.setingDiv').append(result.partialData);
                    } else {
                        $('.tblShopDiamondDiv').removeClass('d-none');
                        $('.setingDiv').addClass('d-none');
                    }
                    // Execute custom success callback
                    successCallback(result);
                },
                error: function () {
                    // Handle error state
                    $('.loader').hide();
                    loadingModal.hide();
                    setButtonSuccess('#btnViewDiamond', 'bi bi-filter', 'Error occurred', false);
                    successCallback({
                        error: true
                    });
                }
            });
        }

