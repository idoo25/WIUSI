    function displayDetailView(ele, productId) {
        var checkElExists = $(ele).next().hasClass('activeDiamondDetail');
        if (!checkElExists) {
            $.ajax({
                url: "/Shop/_ShopDiamondTableDetail",
                data: { productId: productId },
                success: function (result) {
                     var newRow = document.createElement("tr");
      newRow.classList.add("activeDiamondDetail");
      newRow.innerHTML = result;

      attachFallbacks(newRow);

      // Now insert into the DOM
      ele.parentNode.insertBefore(newRow, ele.nextSibling);

      $(ele).addClass('shopDiamondTableTr');
      $(ele).find('a, span').addClass('shopDiamondTableTextColor');
                },
                error: function () {
                }
            });
        }
        else {
            $($(ele).next()).remove();
            $(ele).removeClass('shopDiamondTableTr')
            $(ele).find('a').removeClass('shopDiamondTableTextColor')
        }
    }
